{
  "name": "react-native-netlog-ui",
  "version": "0.1.0",
  "description": "NetLog in-app network inspector for React Native: request list, details with JSON viewer, cURL/HAR export, and optional desktop pairing.",
  "license": "MIT",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "react-native-netlog": "0.1.0",
    "react-native-netlog-json-viewer": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaveh-ap/react-native-netLog.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Kaveh-ap/react-native-netLog/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/Kaveh-ap/react-native-netLog/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
