{
  "name": "@netlog/desktop",
  "version": "0.1.0",
  "description": "Desktop companion for netlog: shows a pairing QR code and a live view of the app's network traffic.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "netlog-desktop": "./bin/netlog-desktop.mjs"
  },
  "main": "./src/server.mjs",
  "exports": {
    ".": "./src/server.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "start": "node bin/netlog-desktop.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@netlog/core": "0.1.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
