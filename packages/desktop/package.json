{
  "name": "react-native-netlog-desktop",
  "version": "0.1.1",
  "description": "Desktop companion for NetLog: shows a pairing QR code and a live view of the app's network traffic.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "netlog-desktop": "./bin/netlog-desktop.mjs"
  },
  "main": "./src/server.mjs",
  "exports": {
    ".": "./src/server.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/netlog-desktop.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "react-native-netlog": "^0.1.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaveh-ap/react-native-netLog.git",
    "directory": "packages/desktop"
  },
  "homepage": "https://github.com/Kaveh-ap/react-native-netLog/tree/main/packages/desktop#readme",
  "bugs": {
    "url": "https://github.com/Kaveh-ap/react-native-netLog/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
